<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ygyong.task_manager.mapper.TaskMapper">

    <!-- column 是结果集列标签，property 是 Task 的 Java 属性名。 -->
    <resultMap id="taskResultMap" type="com.ygyong.task_manager.entity.Task">
        <id column="id" property="id"/>
        <result column="task_title" property="title"/>
        <result column="completed" property="completed"/>
    </resultMap>

    <!-- 教学示范：用别名模拟列名与属性名不同；数据库实际列仍为 title。 -->
    <sql id="taskColumns">
        id, title AS task_title, completed
    </sql>

    <!-- 公共筛选条件：列表和总数查询必须使用同一口径。 -->
    <sql id="taskConditions">
        <where>
            <if test="completed != null">
                AND completed = #{completed}
            </if>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <select id="findAll" resultMap="taskResultMap">
        SELECT <include refid="taskColumns"/>
        FROM task
        ORDER BY id
    </select>

    <select id="findById" resultMap="taskResultMap">
        SELECT <include refid="taskColumns"/>
        FROM task
        WHERE id = #{id}
    </select>

    <select id="findByConditions" resultMap="taskResultMap">
        SELECT <include refid="taskColumns"/>
        FROM task
        <include refid="taskConditions"/>
        ORDER BY id
    </select>

    <select id="findPageByConditions" resultMap="taskResultMap">
        SELECT <include refid="taskColumns"/>
        FROM task
        <include refid="taskConditions"/>
        ORDER BY id
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByConditions" resultType="long">
        SELECT COUNT(*) FROM task
        <include refid="taskConditions"/>
    </select>
</mapper>
